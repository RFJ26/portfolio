---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Página não encontrada" description="A página que procura não existe.">
  <Container class="py-24 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-4xl font-bold">Página não encontrada</h1>
    <p class="mx-auto mt-4 max-w-md text-muted">A página que procura não existe ou foi movida. / This page doesn't exist.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href="/">Voltar ao início</Button>
      <Button href="/en/" variant="secondary">English</Button>
    </div>
  </Container>
</BaseLayout>
