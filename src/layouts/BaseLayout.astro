---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/seo/SEO.astro';
import { site } from '../data/site';
import { useTranslations, defaultLang, langs, locales, type Lang } from '../i18n/ui';
import { translatePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  lang = defaultLang,
  image,
  imageAlt,
  type,
  noindex,
  jsonLd,
} = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${site.fullName}` : `${site.fullName} · ${t('site.role')}`;
const metaDescription = description ?? `${t('site.role')} · ${site.location}`;
const htmlLang = locales[lang].html;
const ogLocale = locales[lang].og;
// Versões da mesma página noutros idiomas (hreflang). A 404 não tem alternativas.
const alternates = noindex ? [] : langs.map((l) => ({ lang: l, href: new URL(translatePath(Astro.url.pathname, l), Astro.site).href }));
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={site.fullName} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0c10" />
    <SEO
      title={fullTitle}
      description={metaDescription}
      image={image}
      imageAlt={imageAlt}
      type={type}
      locale={ogLocale}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    {alternates.map((a) => <link rel="alternate" hreflang={locales[a.lang].html} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === defaultLang)!.href} />}
    <slot name="head" />
    <!-- Aplica o tema antes de pintar, para não haver "flash". -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        // Escuro por defeito; o claro fica guardado se o visitante o escolher.
        document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body class="relative isolate flex min-h-dvh flex-col">
    <div aria-hidden="true" class="bg-glow pointer-events-none absolute inset-x-0 top-0 -z-10 h-[52rem]"></div>
    <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-x-0 top-0 -z-10 h-[52rem]"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
    >{t('skip')}</a>
    <Header lang={lang}><slot name="header-actions" slot="actions" /></Header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
