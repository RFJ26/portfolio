---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  pt: {
    title: 'Sobre mim',
    description: 'Quem sou, o que estudo, como trabalho e com que tecnologias.',
    eyebrow: 'Sobre',
    intro: 'Programador web no Algarve, estudante na Universidade do Algarve e apaixonado por sites que carregam depressa.',
    body: [
      'Comecei a programar por curiosidade e rapidamente percebi que gosto de construir coisas que as pessoas usam todos os dias. Desde então tenho aprendido sobretudo a fazer: um projeto de cada vez, cada um um pouco mais ambicioso do que o anterior.',
      'Estou a tirar o CTeSP em Sistemas e Tecnologias de Informação na Universidade do Algarve, onde trabalho bases de dados, redes, programação e desenvolvimento web. Muitos dos projetos deste portefólio nasceram de trabalhos do curso.',
      'Fora das aulas faço sites para negócios da região: restaurantes, barbearias, livrarias, alojamentos locais. Gosto de falar diretamente com quem vai usar o resultado e de entregar algo simples de manter, rápido no telemóvel e fácil de encontrar no Google.',
    ],
    principlesTitle: 'Como trabalho',
    principles: [
      { k: 'rápido', v: 'Sites estáticos e leves, que abrem em segundos mesmo em 4G.' },
      { k: 'acessível', v: 'Contraste, teclado e leitores de ecrã pensados desde o início.' },
      { k: 'simples', v: 'Conteúdo fácil de atualizar, sem depender de mim para tudo.' },
      { k: 'claro', v: 'Prazos e orçamentos combinados à partida, sem surpresas.' },
    ],
    timelineTitle: 'Percurso',
    timeline: [
      { when: 'agora', what: 'CTeSP em Sistemas e Tecnologias de Informação', where: 'Universidade do Algarve' },
      { when: 'agora', what: 'Sites para comércio local', where: 'Freelance · Algarve' },
      { when: 'sempre', what: 'Projetos pessoais para aprender', where: 'GitHub' },
    ],
    skillsTitle: 'Tecnologias',
    groups: { frontend: 'frontend', backend: 'backend', tools: 'ferramentas' },
    cta: 'Ver projetos',
    contact: 'Falar comigo',
  },
  en: {
    title: 'About me',
    description: 'Who I am, what I study, how I work and which technologies I use.',
    eyebrow: 'About',
    intro: 'Web developer in the Algarve, student at the University of the Algarve, and a fan of websites that load fast.',
    body: [
      'I started programming out of curiosity and quickly realised I enjoy building things people use every day. Since then I have learned mostly by doing: one project at a time, each a little more ambitious than the last.',
      'I am studying for a CTeSP (higher professional technical course) in Information Systems and Technologies at the University of the Algarve, covering databases, networking, programming and web development. Several projects in this portfolio started as coursework.',
      'Outside class I build websites for local businesses: restaurants, barbershops, bookshops, holiday rentals. I like talking directly to the people who will use the result and delivering something that is easy to maintain, fast on mobile and easy to find on Google.',
    ],
    principlesTitle: 'How I work',
    principles: [
      { k: 'fast', v: 'Lightweight static sites that open in seconds, even on 4G.' },
      { k: 'accessible', v: 'Contrast, keyboard and screen readers considered from day one.' },
      { k: 'simple', v: 'Content you can update yourself, without depending on me.' },
      { k: 'clear', v: 'Deadlines and quotes agreed up front, no surprises.' },
    ],
    timelineTitle: 'Background',
    timeline: [
      { when: 'now', what: 'CTeSP in Information Systems and Technologies', where: 'University of the Algarve' },
      { when: 'now', what: 'Websites for local businesses', where: 'Freelance · Algarve' },
      { when: 'always', what: 'Personal projects to learn', where: 'GitHub' },
    ],
    skillsTitle: 'Technologies',
    groups: { frontend: 'frontend', backend: 'backend', tools: 'tools' },
    cta: 'See projects',
    contact: 'Get in touch',
  },
}[lang];

const skills = {
  frontend: ['HTML', 'CSS', 'JavaScript', 'TypeScript', 'Astro', 'React', 'Tailwind CSS'],
  backend: ['Node.js', 'Express', 'PHP', 'MySQL'],
  tools: ['Git', 'GitHub', 'Vercel', 'Figma', 'Lighthouse'],
} as const;
const p = (path: string) => localizePath(lang, path);
---
<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <Container>
    <SectionHeading as="h1" title={copy.title} intro={copy.intro} />
    <div class="mt-6 max-w-3xl space-y-4">
      {copy.body.map((para) => <p>{para}</p>)}
    </div>

    <section class="mt-14">
      <h2 class="text-2xl">{copy.principlesTitle}</h2>
      <ul class="mt-6 grid gap-5 md:grid-cols-2">
        {copy.principles.map((pr, i) => (
          <li class="boxed lift flex gap-4 p-6">
            <span class="text-gradient font-display text-3xl font-bold leading-none" aria-hidden="true">0{i + 1}</span>
            <div>
              <h3 class="text-lg capitalize">{pr.k}</h3>
              <p class="mt-1 text-sm text-muted">{pr.v}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <div class="flex items-center gap-4">
        <span class="boxed icon-box" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5zM6 11v5c3 2 9 2 12 0v-5" /></svg>
        </span>
        <h2 class="text-2xl">{copy.timelineTitle}</h2>
      </div>
      <!-- Linha temporal ao estilo do vCard: linha vertical alinhada com o ícone e pontos em gradiente -->
      <ol class="mt-6 ml-6 border-l border-surface-3">
        {copy.timeline.map((item) => (
          <li class="relative pb-7 pl-9 last:pb-0">
            <span class="bg-gradient-accent absolute top-1.5 -left-[7px] size-3.5 rounded-full ring-4 ring-surface-3" aria-hidden="true"></span>
            <h3 class="text-base text-ink">{item.what}</h3>
            <p class="mt-0.5 text-sm font-medium text-accent">{item.when}</p>
            <p class="text-sm text-muted">{item.where}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl">{copy.skillsTitle}</h2>
      <dl class="boxed mt-6 space-y-5 p-6">
        {(Object.keys(skills) as (keyof typeof skills)[]).map((g) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6">
            <dt class="w-28 shrink-0 text-sm font-semibold capitalize text-ink">{copy.groups[g]}</dt>
            <dd>
              <ul class="flex flex-wrap gap-1.5">
                {skills[g].map((s) => <li><Tag>{s}</Tag></li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href={p('/projetos/')}>{copy.cta} <span aria-hidden="true">→</span></Button>
      <Button href={p('/contacto/')} variant="secondary">{copy.contact}</Button>
    </div>
  </Container>
</BaseLayout>
