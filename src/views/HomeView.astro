---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import CallToAction from '../components/home/CallToAction.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import { services } from '../data/services';
import { personJsonLd } from '../lib/structured-data';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = (path: string) => localizePath(lang, path);

const copy = {
  pt: {
    description: 'Programador web no Algarve e estudante de Sistemas e Tecnologias de Informação na UAlg. Crio sites rápidos e acessíveis para comércio local.',
    eyebrow: 'Disponível para novos projetos',
    title: 'Crio sites rápidos para <span class="text-gradient">negócios locais</span>.',
    intro: 'Sou o Romeu, programador web no Algarve e estudante do CTeSP em Sistemas e Tecnologias de Informação na Universidade do Algarve. Ajudo restaurantes, lojas e alojamentos a ter um site que carrega depressa e é fácil de manter.',
    primary: 'Ver projetos',
    secondary: 'Falar comigo',
    terminal: {
      cmd: 'whoami',
      out: [
        { key: 'nome', value: 'Romeu' },
        { key: 'local', value: 'Algarve, PT' },
        { key: 'estudo', value: 'CTeSP TI · UAlg' },
        { key: 'faço', value: 'sites para comércio local' },
        { key: 'estado', value: 'disponível ✓' },
      ],
    },
    featuredEyebrow: 'Trabalho recente',
    featuredTitle: 'Projetos em destaque',
    featuredIntro: 'Sites para clientes, projetos do curso e ferramentas que fiz para aprender.',
    featuredAll: 'Ver todos',
    servicesEyebrow: 'Serviços',
    servicesTitle: 'Como posso ajudar',
    servicesIntro: 'Do primeiro site à manutenção do dia a dia, com foco em performance, acessibilidade e simplicidade.',
    ctaTitle: 'Tem um projeto em mente?',
    ctaText: 'Conte-me o que precisa. Respondo normalmente em 24 horas.',
    cta: 'Pedir orçamento',
  },
  en: {
    description: 'Web developer in the Algarve and Information Systems and Technologies student at the University of the Algarve. I build fast, accessible websites for local businesses.',
    eyebrow: 'Available for new projects',
    title: 'I build fast websites for <span class="text-gradient">local businesses</span>.',
    intro: "I'm Romeu, a web developer in the Algarve and a student of Information Systems and Technologies (CTeSP) at the University of the Algarve. I help restaurants, shops and holiday rentals get a website that loads fast and is easy to maintain.",
    primary: 'See projects',
    secondary: 'Get in touch',
    terminal: {
      cmd: 'whoami',
      out: [
        { key: 'name', value: 'Romeu' },
        { key: 'location', value: 'Algarve, PT' },
        { key: 'studying', value: 'CTeSP IT · UAlg' },
        { key: 'builds', value: 'sites for local business' },
        { key: 'status', value: 'available ✓' },
      ],
    },
    featuredEyebrow: 'Recent work',
    featuredTitle: 'Featured projects',
    featuredIntro: 'Client websites, course projects and tools I built to learn.',
    featuredAll: 'See all',
    servicesEyebrow: 'Services',
    servicesTitle: 'How I can help',
    servicesIntro: 'From your first website to day-to-day maintenance, with a focus on performance, accessibility and simplicity.',
    ctaTitle: 'Have a project in mind?',
    ctaText: 'Tell me what you need. I usually reply within 24 hours.',
    cta: 'Ask for a quote',
  },
}[lang];

const heroStack = ['Astro', 'TypeScript', 'Tailwind CSS', 'Node.js'];
---
<BaseLayout lang={lang} description={copy.description} type="profile" jsonLd={personJsonLd(Astro.site!, lang, copy.description)}>
  <Hero
    eyebrow={copy.eyebrow}
    title={copy.title}
    intro={copy.intro}
    primary={{ href: p('/projetos/'), label: copy.primary }}
    secondary={{ href: p('/contacto/'), label: copy.secondary }}
    terminal={copy.terminal}
    stack={heroStack}
  />
  <FeaturedProjects lang={lang} eyebrow={copy.featuredEyebrow} title={copy.featuredTitle} intro={copy.featuredIntro} all={copy.featuredAll} />
  <Services eyebrow={copy.servicesEyebrow} title={copy.servicesTitle} intro={copy.servicesIntro} items={services[lang]} />
  <CallToAction title={copy.ctaTitle} text={copy.ctaText} cta={{ href: p('/contacto/'), label: copy.cta }} />
</BaseLayout>
