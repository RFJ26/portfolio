---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Services from '../components/home/Services.astro';
import CallToAction from '../components/home/CallToAction.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import { services } from '../data/services';
import { personJsonLd } from '../lib/structured-data';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = (path: string) => localizePath(lang, path);

const copy = {
  pt: {
    description: 'Programador web no Algarve e estudante de Sistemas e Tecnologias de Informação na UAlg. Crio sites rápidos e acessíveis para comércio local.',
    title: 'Olá, sou o Romeu',
    lead: 'Crio sites <span class="text-gradient font-semibold">rápidos, acessíveis e fáceis de manter</span> para negócios locais no Algarve.',
    body: [
      'Sou programador web e estudante do CTeSP em Sistemas e Tecnologias de Informação na Universidade do Algarve. Ajudo restaurantes, lojas, barbearias e alojamentos locais a ter um site que carrega depressa no telemóvel e aparece no Google.',
      'Gosto de trabalhar diretamente com quem vai usar o site: perceber o negócio, propor algo simples e entregar uma página que o próprio dono consegue atualizar.',
    ],
    primary: 'Ver projetos',
    secondary: 'Falar comigo',
    servicesTitle: 'O que faço',
    featuredTitle: 'Projetos em destaque',
    featuredAll: 'Ver todos',
    ctaTitle: 'Tem um projeto em mente?',
    ctaText: 'Conte-me o que precisa. Respondo normalmente em 24 horas.',
    cta: 'Pedir orçamento',
  },
  en: {
    description: 'Web developer in the Algarve and Information Systems and Technologies student at the University of the Algarve. I build fast, accessible websites for local businesses.',
    title: "Hi, I'm Romeu",
    lead: 'I build <span class="text-gradient font-semibold">fast, accessible, easy-to-maintain</span> websites for local businesses in the Algarve.',
    body: [
      "I'm a web developer and a student of Information Systems and Technologies (CTeSP) at the University of the Algarve. I help restaurants, shops, barbershops and holiday rentals get a website that loads fast on mobile and shows up on Google.",
      'I like working directly with the people who will use the site: understanding the business, proposing something simple and delivering a page the owner can update on their own.',
    ],
    primary: 'See projects',
    secondary: 'Get in touch',
    servicesTitle: 'What I do',
    featuredTitle: 'Featured projects',
    featuredAll: 'See all',
    ctaTitle: 'Have a project in mind?',
    ctaText: 'Tell me what you need. I usually reply within 24 hours.',
    cta: 'Ask for a quote',
  },
}[lang];
---
<BaseLayout lang={lang} description={copy.description} type="profile" jsonLd={personJsonLd(Astro.site!, lang, copy.description)}>
  <section>
    <SectionHeading as="h1" title={copy.title} />
    <p class="mt-6 max-w-2xl text-lg text-ink sm:text-xl" set:html={copy.lead} />
    {copy.body.map((para) => <p class="mt-4 max-w-2xl">{para}</p>)}
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={p('/projetos/')}>{copy.primary} <span aria-hidden="true">→</span></Button>
      <Button href={p('/contacto/')} variant="secondary">{copy.secondary}</Button>
    </div>
  </section>

  <Services title={copy.servicesTitle} items={services[lang]} />
  <FeaturedProjects lang={lang} title={copy.featuredTitle} all={copy.featuredAll} />
  <CallToAction title={copy.ctaTitle} text={copy.ctaText} cta={{ href: p('/contacto/'), label: copy.cta }} />
</BaseLayout>
