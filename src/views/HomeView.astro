---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import CallToAction from '../components/home/CallToAction.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import { services } from '../data/services';
import { personJsonLd } from '../lib/structured-data';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = (path: string) => localizePath(lang, path);

const copy = {
  pt: {
    description: 'Programador web júnior no Algarve. Desenvolvo sites rápidos e acessíveis para comércio local e trabalho numa empresa de software.',
    eyebrow: 'Disponível para novos projetos no Algarve',
    title: 'Sites rápidos e claros para <span class="text-accent">negócios locais</span>.',
    intro: 'Sou o Romeu, programador júnior numa empresa de software e estudante do CTeSP em Sistemas e Tecnologias de Informação na Universidade do Algarve. Nas horas livres crio sites para o comércio local.',
    primary: 'Ver projetos',
    secondary: 'Falar comigo',
    featuredEyebrow: 'Trabalho recente',
    featuredTitle: 'Projetos em destaque',
    featuredIntro: 'Uma seleção de sites e aplicações que fiz para clientes, para a empresa e para aprender.',
    featuredAll: 'Ver todos',
    servicesEyebrow: 'Serviços',
    servicesTitle: 'Como posso ajudar',
    servicesIntro: 'Do primeiro site à manutenção do dia a dia, com foco em performance, acessibilidade e simplicidade.',
    ctaTitle: 'Tem um projeto em mente?',
    ctaText: 'Conte-me o que precisa. Respondo normalmente em 24 horas.',
    cta: 'Pedir orçamento',
  },
  en: {
    description: 'Junior web developer in the Algarve, Portugal. I build fast, accessible websites for local businesses and work at a software company.',
    eyebrow: 'Available for new projects in the Algarve',
    title: 'Fast, clear websites for <span class="text-accent">local businesses</span>.',
    intro: "I'm Romeu, a junior developer at a software company and a student of Information Systems and Technologies (CTeSP) at the University of the Algarve. In my spare time I build websites for local businesses.",
    primary: 'See projects',
    secondary: 'Get in touch',
    featuredEyebrow: 'Recent work',
    featuredTitle: 'Featured projects',
    featuredIntro: 'A selection of websites and apps I built for clients, for work and to learn.',
    featuredAll: 'See all',
    servicesEyebrow: 'Services',
    servicesTitle: 'How I can help',
    servicesIntro: 'From your first website to day-to-day maintenance, with a focus on performance, accessibility and simplicity.',
    ctaTitle: 'Have a project in mind?',
    ctaText: 'Tell me what you need. I usually reply within 24 hours.',
    cta: 'Ask for a quote',
  },
}[lang];
---
<BaseLayout lang={lang} description={copy.description} type="profile" jsonLd={personJsonLd(Astro.site!, lang, copy.description)}>
  <Hero
    eyebrow={copy.eyebrow}
    title={copy.title}
    intro={copy.intro}
    primary={{ href: p('/projetos/'), label: copy.primary }}
    secondary={{ href: p('/contacto/'), label: copy.secondary }}
  />
  <FeaturedProjects lang={lang} eyebrow={copy.featuredEyebrow} title={copy.featuredTitle} intro={copy.featuredIntro} all={copy.featuredAll} />
  <Services eyebrow={copy.servicesEyebrow} title={copy.servicesTitle} intro={copy.servicesIntro} items={services[lang]} />
  <CallToAction title={copy.ctaTitle} text={copy.ctaText} cta={{ href: p('/contacto/'), label: copy.cta }} />
</BaseLayout>
