---
interface Props { eyebrow?: string; title: string; intro?: string; as?: 'h1' | 'h2' | 'h3' }
const { eyebrow, title, intro, as: H = 'h2' } = Astro.props;
---
<div class="max-w-2xl">
  {eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-sea">{eyebrow}</p>}
  <H class:list={['title-bar', H === 'h1' ? 'text-3xl sm:text-[2.1rem]' : H === 'h2' ? 'text-2xl' : 'text-xl']}>{title}</H>
  {intro && <p class="mt-5 text-ink-soft">{intro}</p>}
</div>
