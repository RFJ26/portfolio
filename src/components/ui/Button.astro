---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', type = 'button', external = false, class: className, ...rest } = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold no-underline transition-all duration-200 cursor-pointer disabled:cursor-not-allowed disabled:opacity-60';
const variants = {
  primary: 'bg-gradient-accent text-on-accent shadow-[0_10px_28px_-12px_var(--c-accent)] hover:-translate-y-px hover:brightness-110',
  secondary: 'boxed text-accent hover:text-ink',
};
const classes = [base, variants[variant], className];
---
{href ? (
  <a href={href} class:list={classes} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} {...rest}><slot /></a>
) : (
  <button type={type} class:list={classes} {...rest}><slot /></button>
)}
