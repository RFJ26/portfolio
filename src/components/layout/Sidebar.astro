---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../data/site';
import { useTranslations, locales, type Lang } from '../../i18n/ui';
import { translatePath } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherHref = translatePath(Astro.url.pathname, otherLang);

const info = [
  { label: t('info.email'), value: site.email, href: `mailto:${site.email}`, icon: 'M4 6h16v12H4zM4 7l8 6 8-6' },
  { label: t('info.location'), value: site.location, icon: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z' },
  { label: t('info.study'), value: t('info.studyValue'), icon: 'M2 9l10-5 10 5-10 5zM6 11v5c3 2 9 2 12 0v-5' },
  { label: t('info.status'), value: t('info.statusValue'), icon: 'M20 6L9 17l-5-5' },
];

const socials = [
  { label: 'GitHub', href: site.social.github, icon: 'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21' },
  { label: 'LinkedIn', href: site.social.linkedin, icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
];
---
<aside class="panel relative overflow-hidden p-5 lg:sticky lg:top-12 lg:max-h-[calc(100dvh-6rem)] lg:overflow-y-auto lg:p-7" data-sidebar>
  <div class="flex items-center gap-4 lg:flex-col lg:gap-5 lg:text-center">
    <!-- Avatar: troca por uma fotografia em src/assets se quiseres -->
    <div class="boxed flex size-20 shrink-0 items-center justify-center lg:size-36 lg:rounded-[28px]" aria-hidden="true">
      <span class="text-gradient font-display text-4xl font-bold lg:text-7xl">{site.name.charAt(0)}</span>
    </div>
    <div class="min-w-0">
      <p class="font-display text-xl font-semibold text-ink lg:text-2xl">{site.fullName}</p>
      <p class="mt-2 inline-block rounded-lg bg-surface-2 px-3 py-1 text-xs text-ink">{t('site.role')}</p>
    </div>
  </div>

  <button
    type="button"
    data-sidebar-toggle
    aria-expanded="false"
    aria-controls="sidebar-more"
    data-label-show={t('sidebar.show')}
    data-label-hide={t('sidebar.hide')}
    class="boxed absolute top-0 right-0 cursor-pointer rounded-none rounded-bl-[14px] px-3 py-2 text-xs font-medium text-accent lg:hidden"
  >{t('sidebar.show')}</button>

  <div id="sidebar-more" class="hidden lg:block" data-sidebar-more>
    <div class="my-6 h-px bg-border"></div>
    <ul class="space-y-5">
      {info.map((i) => (
        <li class="flex items-center gap-4">
          <span class="boxed icon-box size-11" aria-hidden="true">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={i.icon} /></svg>
          </span>
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-wide text-muted">{i.label}</p>
            {i.href ? (
              <a href={i.href} class="block text-[13px] text-ink no-underline hover:text-accent">{i.value.split('@')[0]}@<wbr />{i.value.split('@')[1]}</a>
            ) : (
              <p class="text-sm text-ink">{i.value}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div class="my-6 h-px bg-border"></div>
    <div class="flex items-center justify-between gap-3">
      <ul class="flex items-center gap-1" aria-label={t('social')}>
        {socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} title={s.label} class="inline-flex size-10 items-center justify-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-accent">
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-1">
        <a
          href={otherHref}
          hreflang={locales[otherLang].html}
          lang={locales[otherLang].html}
          aria-label={t('lang.switch')}
          title={t('lang.switch')}
          class="inline-flex h-10 items-center rounded-lg px-3 text-sm font-semibold uppercase text-muted no-underline transition-colors hover:bg-surface-2 hover:text-ink"
        >{otherLang}</a>
        <ThemeToggle label={t('theme.toggle')} />
      </div>
    </div>
  </div>
</aside>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
  const more = document.querySelector<HTMLElement>('[data-sidebar-more]');
  btn?.addEventListener('click', () => {
    if (!more) return;
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    more.classList.toggle('hidden', open);
    btn.textContent = (open ? btn.dataset.labelShow : btn.dataset.labelHide) ?? '';
  });
</script>
