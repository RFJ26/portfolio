---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../data/site';
import { useTranslations, locales, type Lang } from '../../i18n/ui';
import { localizePath, translatePath } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: localizePath(lang, '/projetos/'), label: t('nav.projects') },
  { href: localizePath(lang, '/sobre/'), label: t('nav.about') },
  { href: localizePath(lang, '/contacto/'), label: t('nav.contact') },
];

const current = Astro.url.pathname;
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherHref = translatePath(current, otherLang);
const isActive = (href: string) => current === href || current.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-border/60 bg-bg/70 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={localizePath(lang, '/')} class="group font-mono text-[0.95rem] font-semibold text-ink no-underline">
      <span class="text-sea" aria-hidden="true">~/</span>{site.name.toLowerCase()}<span class="ml-0.5 inline-block h-[1.05em] w-[0.55em] translate-y-[0.15em] bg-accent motion-safe:animate-pulse" aria-hidden="true"></span>
    </a>

    <nav aria-label={t('nav.main')} class="flex items-center gap-1">
      <ul id="nav-links" class="hidden items-center gap-1 md:flex">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 font-mono text-sm no-underline transition-colors hover:bg-surface-2 hover:text-ink',
                isActive(l.href) ? 'text-ink' : 'text-muted',
              ]}
            >{isActive(l.href) && <span class="text-accent" aria-hidden="true">./</span>}{l.label.toLowerCase()}</a>
          </li>
        ))}
      </ul>
      <slot name="actions" />
      <a
        href={otherHref}
        hreflang={locales[otherLang].html}
        lang={locales[otherLang].html}
        aria-label={t('lang.switch')}
        title={t('lang.switch')}
        class="inline-flex h-10 items-center rounded-md px-3 font-mono text-sm font-medium uppercase text-muted no-underline transition-colors hover:bg-surface-2 hover:text-ink"
      >{otherLang}</a>
      <ThemeToggle label={t('theme.toggle')} />
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.menu')}
        class="inline-flex size-10 items-center justify-center rounded-md text-muted hover:bg-surface-2 hover:text-ink md:hidden cursor-pointer"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </nav>
  </div>

  <div id="mobile-menu" hidden class="border-t border-border bg-bg md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={['block rounded-lg px-3 py-3 font-medium no-underline hover:bg-surface-2', isActive(l.href) ? 'text-accent' : 'text-ink']}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (!menu) return;
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu.hidden = open;
  });
</script>
