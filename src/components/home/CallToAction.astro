---
import Button from '../ui/Button.astro';

interface Props { title: string; text: string; cta: { href: string; label: string } }
const { title, text, cta } = Astro.props;
---
<section class="mt-14">
  <div class="boxed relative overflow-hidden p-7 sm:p-9">
    <div aria-hidden="true" class="bg-gradient-accent absolute -top-24 -right-16 size-64 rounded-full opacity-20 blur-3xl"></div>
    <div class="relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-2xl">{title}</h2>
        <p class="mt-2 text-muted">{text}</p>
      </div>
      <Button href={cta.href}>{cta.label} <span aria-hidden="true">→</span></Button>
    </div>
  </div>
</section>
