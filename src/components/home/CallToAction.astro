---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props { title: string; text: string; cta: { href: string; label: string } }
const { title, text, cta } = Astro.props;
---
<section class="py-10">
  <Container>
    <div class="relative overflow-hidden rounded-2xl border border-border bg-surface px-6 py-14 sm:px-12">
      <div aria-hidden="true" class="bg-glow absolute inset-0 -z-0 opacity-90"></div>
      <div aria-hidden="true" class="bg-grid absolute inset-0 -z-0"></div>
      <div class="relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <p class="eyebrow mb-3" aria-hidden="true">$ ./contact.sh</p>
          <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
          <p class="mt-3 text-muted">{text}</p>
        </div>
        <Button href={cta.href}>{cta.label} <span aria-hidden="true">→</span></Button>
      </div>
    </div>
  </Container>
</section>
