---
import ProjectCard from '../projects/ProjectCard.astro';
import { getFeaturedProjects } from '../../lib/projects';
import { categoryLabels } from '../../i18n/categories';
import { localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; title: string; all: string }
const { lang, title, all } = Astro.props;
const featured = await getFeaturedProjects(lang, 3);
---
<section class="mt-14">
  <div class="flex items-end justify-between gap-4">
    <h2 class="text-2xl">{title}</h2>
    <a href={localizePath(lang, '/projetos/')} class="text-sm font-medium text-accent no-underline hover:text-accent-hover">{all} →</a>
  </div>
  <ul class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
    {featured.map((p) => (
      <li>
        <ProjectCard
          project={p}
          href={localizePath(lang, `/projetos/${p.id}/`)}
          categoryLabel={categoryLabels[lang][p.data.category]}
        />
      </li>
    ))}
  </ul>
</section>
