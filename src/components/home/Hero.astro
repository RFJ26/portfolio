---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primary: { href: string; label: string };
  secondary: { href: string; label: string };
  terminal: { cmd: string; out: { key: string; value: string }[] };
  stack: string[];
}
const { eyebrow, title, intro, primary, secondary, terminal, stack } = Astro.props;
---
<section>
  <Container class="grid items-center gap-14 pt-16 pb-20 sm:pt-24 lg:grid-cols-[1.15fr_1fr] lg:pb-28">
    <div>
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-3 py-1 font-mono text-xs text-muted backdrop-blur">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full rounded-full bg-sea opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex size-2 rounded-full bg-sea"></span>
        </span>
        {eyebrow}
      </p>
      <h1 class="text-[2.6rem] font-bold leading-[1.05] sm:text-6xl lg:text-[4.2rem]">
        <Fragment set:html={title} />
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">{intro}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={primary.href}>
          {primary.label}
          <span aria-hidden="true" class="transition-transform group-hover/btn:translate-x-0.5">→</span>
        </Button>
        <Button href={secondary.href} variant="secondary">{secondary.label}</Button>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm text-muted" aria-label="Stack">
        {stack.map((s) => <li><span class="text-accent" aria-hidden="true">▹ </span>{s}</li>)}
      </ul>
    </div>

    <!-- Cartão de terminal (decorativo, mas legível por leitores de ecrã) -->
    <div class="relative">
      <div aria-hidden="true" class="absolute -inset-6 -z-10 rounded-[2rem] bg-gradient-to-br from-accent/25 via-transparent to-sea/25 blur-2xl"></div>
      <figure class="overflow-hidden rounded-xl border border-border bg-surface/90 shadow-2xl shadow-black/20 backdrop-blur">
        <div class="flex items-center gap-2 border-b border-border bg-surface-2/70 px-4 py-3">
          <span class="size-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
          <span class="size-3 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
          <span class="size-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
          <figcaption class="ml-3 font-mono text-xs text-muted">romeu@algarve: ~</figcaption>
        </div>
        <div class="p-5 font-mono text-[0.85rem] leading-7 sm:p-6 sm:text-sm">
          <p><span class="text-sea">➜</span> <span class="text-accent">~</span> {terminal.cmd}</p>
          <dl class="mt-2">
            {terminal.out.map((line) => (
              <div class="flex gap-3">
                <dt class="w-24 shrink-0 text-muted">{line.key}</dt>
                <dd class="text-ink">{line.value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-3"><span class="text-sea">➜</span> <span class="text-accent">~</span> <span class="inline-block h-4 w-2 translate-y-0.5 bg-ink motion-safe:animate-pulse" aria-hidden="true"></span></p>
        </div>
      </figure>
    </div>
  </Container>
</section>
