---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primary: { href: string; label: string };
  secondary: { href: string; label: string };
}
const { eyebrow, title, intro, primary, secondary } = Astro.props;
---
<section class="relative overflow-hidden">
  <!-- Linha decorativa: o horizonte do Atlântico ao fim da tarde -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent"></div>
  <Container class="py-20 sm:py-28">
    <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-sm text-muted">
      <span class="size-2 rounded-full bg-sea" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 class="max-w-3xl text-4xl font-extrabold sm:text-6xl">
      <Fragment set:html={title} />
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">{intro}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={primary.href}>{primary.label}</Button>
      <Button href={secondary.href} variant="secondary">{secondary.label}</Button>
    </div>
  </Container>
</section>
