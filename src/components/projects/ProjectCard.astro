---
import { Image } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import { techSlug, type Project } from '../../lib/projects';

interface Props {
  project: Project;
  href: string;
  categoryLabel: string;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { project, href, categoryLabel, headingLevel: H = 'h3', eager = false } = Astro.props;
const { title, summary, stack, cover, coverAlt } = project.data;
---
<article class="group relative flex h-full flex-col" data-project data-techs={stack.map(techSlug).join(' ')}>
  <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-surface-2 shadow-[var(--shadow)]">
    <Image
      src={cover}
      alt={coverAlt ?? ''}
      widths={[400, 640, 800]}
      sizes="(min-width: 1280px) 280px, (min-width: 640px) 45vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <!-- Camada que aparece ao passar o rato, com o ícone de "ver" -->
    <div class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/50" aria-hidden="true">
      <span class="boxed flex size-12 scale-75 items-center justify-center text-accent opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
      </span>
    </div>
  </div>
  <div class="flex flex-1 flex-col px-1 pt-4">
    <H class="text-lg leading-snug">
      <!-- O link cobre o cartão inteiro através do ::after -->
      <a href={href} class="text-ink no-underline after:absolute after:inset-0 after:content-[''] group-hover:text-accent">{title}</a>
    </H>
    <p class="mt-0.5 text-sm text-muted">{categoryLabel}</p>
    <p class="mt-2 line-clamp-3 flex-1 text-sm">{summary}</p>
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {stack.map((tech) => <li><Tag>{tech}</Tag></li>)}
    </ul>
  </div>
</article>
