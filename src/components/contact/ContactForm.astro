---
import { PUBLIC_FORMSPREE_ID } from 'astro:env/client';
import Button from '../ui/Button.astro';

export interface ContactLabels {
  name: string; email: string; type: string; typeOptions: string[]; message: string; consent: string;
  submit: string; sending: string; success: string; error: string; notConfigured: string;
  errors: { required: string; email: string; minMessage: string; consent: string };
  privacyNote: string;
}
interface Props { labels: ContactLabels; lang: string }
const { labels, lang } = Astro.props;
const action = PUBLIC_FORMSPREE_ID ? `https://formspree.io/f/${PUBLIC_FORMSPREE_ID}` : undefined;

const field = 'mt-1.5 block w-full rounded-xl border border-border bg-surface px-4 py-3 text-ink placeholder:text-muted/70 transition-colors focus:border-accent focus:outline-none aria-invalid:border-red-600 dark:aria-invalid:border-red-400';
const error = 'mt-1.5 hidden text-sm font-medium text-red-700 dark:text-red-400';
---
{!action && (
  <p class="mb-6 rounded-xl border border-dashed border-accent bg-accent-soft p-4 text-sm" role="note">{labels.notConfigured}</p>
)}
<form
  action={action}
  method="POST"
  class="space-y-5"
  data-contact-form
  data-msg-required={labels.errors.required}
  data-msg-email={labels.errors.email}
  data-msg-min={labels.errors.minMessage}
  data-msg-consent={labels.errors.consent}
  data-msg-sending={labels.sending}
  data-msg-success={labels.success}
  data-msg-error={labels.error}
>
  <input type="hidden" name="_language" value={lang} />
  <!-- Honeypot anti-spam do Formspree: humanos não o veem -->
  <div class="hidden" aria-hidden="true">
    <label>Não preencher <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="text-sm font-semibold">{labels.name}</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" maxlength="100" class={field} aria-describedby="cf-name-error" />
      <p id="cf-name-error" class={error}></p>
    </div>
    <div>
      <label for="cf-email" class="text-sm font-semibold">{labels.email}</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" maxlength="200" class={field} aria-describedby="cf-email-error" />
      <p id="cf-email-error" class={error}></p>
    </div>
  </div>

  <div>
    <label for="cf-type" class="text-sm font-semibold">{labels.type}</label>
    <select id="cf-type" name="type" class={field}>
      {labels.typeOptions.map((o) => <option>{o}</option>)}
    </select>
  </div>

  <div>
    <label for="cf-message" class="text-sm font-semibold">{labels.message}</label>
    <textarea id="cf-message" name="message" required minlength="20" maxlength="5000" rows="6" class={field} aria-describedby="cf-message-error"></textarea>
    <p id="cf-message-error" class={error}></p>
  </div>

  <div>
    <label class="flex items-start gap-3 text-sm text-muted">
      <input id="cf-consent" name="consent" type="checkbox" required value="sim" class="mt-1 size-4 accent-[var(--c-accent)]" aria-describedby="cf-consent-error" />
      <span>{labels.consent}</span>
    </label>
    <p id="cf-consent-error" class={error}></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <Button type="submit" data-submit disabled={!action}>{labels.submit}</Button>
    <p class="text-xs text-muted">{labels.privacyNote}</p>
  </div>
  <p data-form-status role="status" aria-live="polite" class="hidden rounded-xl p-4 text-sm font-medium"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  // getAttribute: a propriedade form.action devolve o URL da página quando o atributo não existe.
  if (form && form.getAttribute('action')) {
    // Com JS ativo usamos validação própria; sem JS, vale a validação nativa do browser.
    form.noValidate = true;
    const d = form.dataset;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = submit.textContent;
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    const fields = {
      name: form.elements.namedItem('name') as HTMLInputElement,
      email: form.elements.namedItem('email') as HTMLInputElement,
      message: form.elements.namedItem('message') as HTMLTextAreaElement,
      consent: form.elements.namedItem('consent') as HTMLInputElement,
    };

    function validate(key: keyof typeof fields): boolean {
      const el = fields[key];
      let msg = '';
      if (key === 'consent') {
        if (!fields.consent.checked) msg = d.msgConsent!;
      } else {
        const v = el.value.trim();
        if (!v) msg = d.msgRequired!;
        else if (key === 'email' && !EMAIL_RE.test(v)) msg = d.msgEmail!;
        else if (key === 'message' && v.length < 20) msg = d.msgMin!;
      }
      const errEl = document.getElementById(`cf-${key}-error`)!;
      errEl.textContent = msg;
      errEl.classList.toggle('hidden', !msg);
      el.setAttribute('aria-invalid', String(!!msg));
      return !msg;
    }

    // Valida ao sair do campo e volta a validar enquanto se corrige.
    (Object.keys(fields) as (keyof typeof fields)[]).forEach((key) => {
      const el = fields[key];
      el.addEventListener('blur', () => validate(key));
      el.addEventListener(key === 'consent' ? 'change' : 'input', () => {
        if (el.getAttribute('aria-invalid') === 'true') validate(key);
      });
    });

    function setStatus(kind: 'ok' | 'error' | 'info', text: string) {
      status.textContent = text;
      status.className = 'rounded-xl p-4 text-sm font-medium ' + (
        kind === 'ok' ? 'bg-accent-soft text-ink' : kind === 'error' ? 'border border-red-600 text-red-700 dark:text-red-400' : 'text-muted'
      );
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const results = (Object.keys(fields) as (keyof typeof fields)[]).map((k) => [k, validate(k)] as const);
      const firstInvalid = results.find(([, ok]) => !ok);
      if (firstInvalid) {
        fields[firstInvalid[0]].focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = d.msgSending!;
      setStatus('info', d.msgSending!);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        setStatus('ok', d.msgSuccess!);
      } catch {
        setStatus('error', d.msgError!);
      } finally {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
    });
  }
</script>
